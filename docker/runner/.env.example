# DO NOT COMMIT a real .env (this is only an example).
# Generate a >=32 character secret: openssl rand -hex 32
RUNNER_API_KEY=REPLACE_WITH_A_STRONG_SECRET_AT_LEAST_32_CHARACTERS
RUNNER_ALLOWED_ORIGINS=https://your-softwarefactory.example.com,http://localhost:5173
# Paths on the runner HOST, writable by uid:gid 1000:1000.
RUNNER_DATA_DIR=/srv/softwarefactory/runner-data
RUNNER_HOST_WORK_DIR=/srv/softwarefactory/workspaces
# Point to the socket of a dedicated ROOTLESS Docker daemon.
RUNNER_DOCKER_SOCKET=/run/user/1000/docker.sock
# Optional global (single shared job volume) admission limit, 0 disables it.
# E.g. 5 means at most 5 newly accepted jobs in any rolling 60s; replays are free.
RUNNER_MAX_ACCEPTED_PER_MINUTE=0
# The authenticated /v1/readiness endpoint requires a fresh worker heartbeat.
# Allowed values: 10–300 seconds. This does NOT verify the Docker daemon.
RUNNER_WORKER_HEARTBEAT_MAX_AGE_SECONDS=30
# Optional: start with --profile tunnel, and configure Cloudflare hostname to runner-api:8787.
CLOUDFLARE_TUNNEL_TOKEN=REPLACE_ONLY_WHEN_USING_CLOUDFLARE

# Experimental, administrator-only opt-in: npm install pulls packages over
# the network in a SEPARATE preparation container (npm lifecycle scripts disabled).
# Test containers always run with --network=none.
RUNNER_ALLOW_NET_DEPS=false
RUNNER_NPM_REGISTRY=https://registry.npmjs.org/

# Optional role-scoped repair operators, JSON array [ { "id": "alice", "key": "...", "roles": ["propose","review"] }, ... ]
# Generate UNIQUE >=32 character credentials off-host for each operator. Do not commit real secrets.
# Empty means all /v1/repair-sessions routes are disabled (503), while job APIs stay available.
RUNNER_REPAIR_OPERATORS_JSON=

# Optional hot-rotatable private registry. Use Compose override
# compose.repair-operators.yml and mount this DIRECTORY read-only only in API.
# Put operators.json (owned by uid 1000; mode 0600) in the directory, NEVER in Git.
RUNNER_REPAIR_OPERATORS_DIR=/srv/softwarefactory/repair-operators
