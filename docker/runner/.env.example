# DO NOT COMMIT a real .env (this is only an example).
# Generate a >=32 character secret: openssl rand -hex 32
RUNNER_API_KEY=REPLACE_WITH_A_STRONG_SECRET_AT_LEAST_32_CHARACTERS
RUNNER_ALLOWED_ORIGINS=https://your-softwarefactory.example.com,http://localhost:5173
# Paths on the runner HOST, writable by uid:gid 1000:1000.
RUNNER_DATA_DIR=/srv/softwarefactory/runner-data
RUNNER_HOST_WORK_DIR=/srv/softwarefactory/workspaces
# Point to the socket of a dedicated ROOTLESS Docker daemon.
RUNNER_DOCKER_SOCKET=/run/user/1000/docker.sock
# Optional: start with --profile tunnel, and configure Cloudflare hostname to runner-api:8787.
CLOUDFLARE_TUNNEL_TOKEN=REPLACE_ONLY_WHEN_USING_CLOUDFLARE

# Experimental, administrator-only opt-in: npm install pulls packages over
# the network in a SEPARATE preparation container (npm lifecycle scripts disabled).
# Test containers always run with --network=none.
RUNNER_ALLOW_NET_DEPS=false
RUNNER_NPM_REGISTRY=https://registry.npmjs.org/
